# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# turbo
.turbo

# firebase emulator
firestore-debug.log
firebase-debug.log

# expo
.expo/
dist/

# Native projects generated by `expo prebuild` / `expo run:*`. This app uses
# Continuous Native Generation, so they are build output, not source.
apps/mobile/android/
apps/mobile/ios/

# Firebase app config for the mobile app. Client-side config rather than
# server secrets, but kept out of the repo by choice — supply them to EAS
# builds as file-type environment variables.
apps/mobile/google-services.json
apps/mobile/GoogleService-Info.plist
