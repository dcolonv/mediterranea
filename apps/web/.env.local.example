# Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (for server-side)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account-email
FIREBASE_ADMIN_PRIVATE_KEY="your-private-key"

# Booking agent (OpenAI Responses API)
OPENAI_API_KEY=sk-...
# Optional — defaults to gpt-5.6
OPENAI_AGENT_MODEL=gpt-5.6

# Notifications — email (Resend). Leave unset to keep email dormant (logs only).
RESEND_API_KEY=re_...
NOTIFICATIONS_EMAIL_FROM="Mediterránea Face Studio <noreply@yourdomain.com>"

# Notifications — SMS (Twilio). Leave unset to keep SMS dormant (logs only).
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+34600000000

# Scheduled reminders — shared secret required to invoke /api/cron/reminders
CRON_SECRET=your-cron-secret

# Payments (Stripe). Gift-card purchase is live once these are set; dormant otherwise.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Public site URL, for Stripe success/cancel redirects (e.g. https://your-domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Client media storage (AWS S3) — before/after photos
AWS_REGION=eu-west-1
AWS_S3_BUCKET=mediterranea-client-media
# Optional key prefix within the bucket (e.g. "photos")
AWS_S3_PREFIX=
# Credentials — omit to use the ambient IAM role / default provider chain
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
