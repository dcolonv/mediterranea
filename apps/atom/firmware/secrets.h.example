#pragma once

/**
 * Copy to secrets.h and fill in. secrets.h is gitignored.
 *
 *   cp firmware/secrets.h.example firmware/secrets.h
 */

#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

/**
 * The Mac's LAN IP while developing — NOT localhost, which on the device means
 * the device itself. Find it with:  ipconfig getifaddr en0
 *
 * This changes when your router hands out a new lease, and a stale value here
 * looks exactly like the device being broken. If it starts happening often,
 * reserve the IP on the router.
 *
 * `pnpm dev:web` already listens on all interfaces, so no extra flags are
 * needed for the device to reach it.
 */
#define SERVER_HOST "192.168.1.50"
#define SERVER_PORT 3000

/**
 * Must match ATOM_DEVICE_TOKEN in apps/web. At least 16 characters; generate:
 *   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
 */
#define DEVICE_TOKEN "replace-me"
