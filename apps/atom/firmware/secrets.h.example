#pragma once

/**
 * Copy to secrets.h and fill in. secrets.h is gitignored.
 *
 *   cp firmware/secrets.h.example firmware/secrets.h
 */

#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

/**
 * Production. Use the www host: the bare domain answers with a redirect, which
 * the device doesn't follow. Port 443 turns on HTTPS, verified against the
 * root certificates built into the ESP32 core.
 */
#define SERVER_HOST "www.mediterraneafacestudio.com"
#define SERVER_PORT 443

/**
 * Or, while developing against `pnpm dev:web`: the Mac's LAN IP — NOT
 * localhost, which on the device means the device itself. Find it with
 * `ipconfig getifaddr en0`; it changes with the network or a new DHCP lease,
 * and a stale value looks exactly like the device being broken.
 *
 * #define SERVER_HOST "192.168.1.50"
 * #define SERVER_PORT 3000
 */

/**
 * Must match ATOM_DEVICE_TOKEN in apps/web. At least 16 characters; generate:
 *   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
 */
#define DEVICE_TOKEN "replace-me"
