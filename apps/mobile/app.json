{
  "expo": {
    "name": "Mediterránea Face Studio",
    "slug": "mediterranea-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mediterranea",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mediterraneafacestudio.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#181818"
      },
      "package": "com.mediterraneafacestudio.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mediterránea to access your photos to add client before/after images.",
          "cameraPermission": "Allow Mediterránea to use the camera to capture client before/after photos."
        }
      ]
    ]
  }
}
