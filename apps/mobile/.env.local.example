# API URL (Next.js web app)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Firebase Client Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Google Sign-In (Firebase Console -> Authentication -> Google, then
# Project settings -> your apps). Requires a development build; Google
# sign-in cannot run in Expo Go.
#
# The WEB client id is what mints the ID token Firebase needs, on BOTH
# platforms. Without it, sign-in returns no idToken and fails.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id
# iOS only: identifies the app to Google.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id
