rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Services: Public read (active only), admin reads all + writes
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Appointments: Public create, admin read/update/delete
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Customers: Admin only
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Staff: public can read active staff (for booking); admin writes
    match /staff/{staffId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Rooms: Admin only (internal resource)
    match /rooms/{roomId} {
      allow read, write: if isAdmin();
    }

    // Client photos metadata: server-only (Admin SDK). No direct client access.
    match /photos/{photoId} {
      allow read, write: if false;
    }

    // Reviews: server-only (submitted, moderated, and displayed via Admin SDK).
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // Treatment recipes: admin only (internal protocol; served via Admin SDK).
    match /recipes/{serviceId} {
      allow read, write: if isAdmin();
    }

    // Waitlist: server-only (managed + matched via Admin SDK).
    match /waitlist/{entryId} {
      allow read, write: if false;
    }

    // Agent audit log: server-only (written via Admin SDK).
    match /agentAudit/{entryId} {
      allow read, write: if false;
    }

    // Gift cards: server-only (purchased via Stripe, managed via Admin SDK).
    match /giftCards/{cardId} {
      allow read, write: if false;
    }

    // Blog + campaigns: server-only (rendered / managed via Admin SDK).
    match /blog/{postId} {
      allow read, write: if false;
    }
    match /campaigns/{campaignId} {
      allow read, write: if false;
    }

    // Studio settings: public read (business hours + policy for booking), admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins: Only admin can read
    match /admins/{adminId} {
      allow read: if isAdmin();
    }

    // Admin = the `admin` role custom claim (fast path) OR the admins allowlist
    // (authoritative fallback, so no one is locked out before claims propagate).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }
  }
}
