rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Services: Public read (active only), admin reads all + writes
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Appointments: public create (the booking flow writes via the client SDK
    // with no signed-in user), admin read/update/delete. The shape is pinned so
    // an open create cannot be used to write arbitrary data or to forge an
    // already-confirmed appointment.
    match /appointments/{appointmentId} {
      allow create: if isValidNewAppointment();
      allow read, update, delete: if isAdmin();
    }

    // Customers: Admin only
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Staff: public can read active staff (for booking); admin writes
    match /staff/{staffId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Rooms: Admin only (internal resource)
    match /rooms/{roomId} {
      allow read, write: if isAdmin();
    }

    // Client photos metadata: server-only (Admin SDK). No direct client access.
    match /photos/{photoId} {
      allow read, write: if false;
    }

    // Reviews: server-only (submitted, moderated, and displayed via Admin SDK).
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // Treatment recipes: admin only (internal protocol; served via Admin SDK).
    match /recipes/{serviceId} {
      allow read, write: if isAdmin();
    }

    // Waitlist: server-only (managed + matched via Admin SDK).
    match /waitlist/{entryId} {
      allow read, write: if false;
    }

    // Agent audit log: server-only (written via Admin SDK).
    match /agentAudit/{entryId} {
      allow read, write: if false;
    }

    // Gift cards: server-only (purchased via Stripe, managed via Admin SDK).
    match /giftCards/{cardId} {
      allow read, write: if false;
    }

    // Blog + campaigns: server-only (rendered / managed via Admin SDK).
    match /blog/{postId} {
      allow read, write: if false;
    }
    match /campaigns/{campaignId} {
      allow read, write: if false;
    }

    // Studio settings: served to the public through the Admin SDK (getPublicPolicy),
    // so no direct client read is needed.
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Admins: Only admin can read
    match /admins/{adminId} {
      allow read: if isAdmin();
    }

    // Anything not matched above is server-only (Admin SDK bypasses rules).
    match /{document=**} {
      allow read, write: if false;
    }

    // A new booking: exactly the fields the booking flow writes, nothing more,
    // and always pending so status cannot be self-approved.
    function isValidNewAppointment() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.keys().hasAll([
             'serviceId', 'serviceName', 'clientName', 'clientEmail', 'clientPhone',
             'appointmentDate', 'appointmentTime', 'durationMinutes', 'status',
             'createdAt', 'updatedAt'
           ])
        && d.keys().hasOnly([
             'serviceId', 'serviceName', 'clientName', 'clientEmail', 'clientPhone',
             'appointmentDate', 'appointmentTime', 'durationMinutes', 'notes',
             'customerId', 'status', 'createdAt', 'updatedAt'
           ])
        && d.serviceId is string && d.serviceId.size() > 0 && d.serviceId.size() <= 200
        && d.serviceName is string && d.serviceName.size() > 0 && d.serviceName.size() <= 200
        && d.clientName is string && d.clientName.size() >= 2 && d.clientName.size() <= 120
        && d.clientEmail is string && d.clientEmail.size() <= 200
        && d.clientPhone is string && d.clientPhone.size() <= 40
        && d.appointmentDate is string && d.appointmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.appointmentTime is string && d.appointmentTime.matches('^[0-9]{1,2}:[0-9]{2}$')
        && d.durationMinutes is number && d.durationMinutes > 0 && d.durationMinutes <= 600
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    // Admin = the `admin` role custom claim (fast path) OR the admins allowlist
    // (authoritative fallback, so no one is locked out before claims propagate).
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }
  }
}
