rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Services: Public read (active only), admin reads all + writes
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Appointments: Public create, admin read/update/delete
    match /appointments/{appointmentId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Customers: Admin only
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Staff: public can read active staff (for booking); admin writes
    match /staff/{staffId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Rooms: Admin only (internal resource)
    match /rooms/{roomId} {
      allow read, write: if isAdmin();
    }

    // Client photos metadata: server-only (Admin SDK). No direct client access.
    match /photos/{photoId} {
      allow read, write: if false;
    }

    // Reviews: server-only (submitted, moderated, and displayed via Admin SDK).
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // Studio settings: public read (business hours + policy for booking), admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins: Only admin can read
    match /admins/{adminId} {
      allow read: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
  }
}
